# Node key and address (filled by setup if missing)
NODE_PRIVATE_KEY=
NODE_ADDRESS=

# RPC endpoints
ETHEREUM_ENDPOINT=https://rpcman.orbs.network/rpc?chain=ethereum&appId=jordanl3test
MATIC_ENDPOINT=https://rpcman.orbs.network/rpc?chain=polygon&appId=jordanl3test

# Service endpoints
SIGNER_ENDPOINT=http://signer:7777

# Control (host process that runs poll + docker-compose)
