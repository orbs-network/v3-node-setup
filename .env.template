# Node key and address (filled by setup if missing)
NODE_PRIVATE_KEY=
NODE_ADDRESS=

# RPC endpoints
ETHEREUM_ENDPOINT=https://rpcman.orbs.network/rpc?chain=ethereum&appId=guardian-v5
MATIC_ENDPOINT=https://rpcman.orbs.network/rpc?chain=polygon&appId=guardian-v5

# Service endpoints
SIGNER_ENDPOINT=http://signer

# Control (host process that runs poll + docker-compose)
# DOCKER_COMPOSE_FILE= path to docker-compose.yml (set by scripts/run.sh or use absolute path)
# BASE_DIR= project root (default /opt/orbs; set to project root for local runs)

# Optional
DOCKER_COMPOSE_DESCRIPTOR_URL=origin/config/test1:docker-compose.yml
# DOCKER_SOCKET_PATH=/var/run/docker.sock
